<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>decisionId</includeMdcKeyName>
            <includeMdcKeyName>skuId</includeMdcKeyName>
            <includeMdcKeyName>ruleName</includeMdcKeyName>
            <includeMdcKeyName>actionType</includeMdcKeyName>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <version>[ignore]</version>
            </fieldNames>
        </encoder>
    </appender>

    <appender name="PRETTY_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Switch to JSON_CONSOLE for production -->
    <root level="INFO">
        <appender-ref ref="PRETTY_CONSOLE"/>
    </root>
</configuration>
